// ============================================================
// Firestore Security Rules — SpesaSmart Optimizer
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Controlla se il listId appartiene all'utente corrente.
    // Per le liste famiglia verifica che il family_id nel documento utente
    // corrisponda al family_id nel listId (es. "family_abc123").
    function ownsListId(listId) {
      return isAuthenticated() && (
        listId == 'user_' + request.auth.uid ||
        (listId.matches('family_.*') &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'family_id' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         listId == 'family_' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.family_id)
      );
    }

    // --- Collezione: users ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- Collezione: shopping_lists ---
    match /shopping_lists/{listId} {
      allow read, write, create: if ownsListId(listId);

      // Sub-collezione items — usa ownsListId sul listId del percorso
      match /items/{itemId} {
        allow read, write, create: if ownsListId(listId);
      }
    }

    // --- Collezione: supermarkets ---
    match /supermarkets/{sid} {
      allow read: if true;
      allow write: if false;
    }

    // --- Collezione: daily_prices ---
    match /daily_prices/{priceId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Collezione: meal_plans (MealPlanner AI) ---
    // Ogni utente ha la propria sotto-collezione di piani pasto
    match /meal_plans/{uid}/plans/{planId} {
      allow read, write, delete: if isOwner(uid);
    }

    // --- Collezione: price_alerts ---
    // Il client deve sempre filtrare con .where('uid', '==', currentUser.uid)
    match /price_alerts/{alertId} {
      allow list, get: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write:     if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create:    if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }
  }
}
